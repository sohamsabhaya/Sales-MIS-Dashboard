{
  "page_name": "Executive Overview",
  "resolution": "1920x1080 (16:9)",
  "theme": "Corporate MIS Executive Theme",
  "visuals": [
    {
      "visual_id": "card_revenue",
      "visual_type": "card",
      "title": "Total Gross Revenue (BRL)",
      "position": { "x": 20, "y": 20, "width": 350, "height": 180 },
      "data_field": "rpt v_monthly_kpis[gross_revenue]",
      "aggregation": "SUM",
      "number_format": "Currency (R$ #,##0.00)"
    },
    {
      "visual_id": "card_orders",
      "visual_type": "card",
      "title": "Total Valid Orders",
      "position": { "x": 390, "y": 20, "width": 350, "height": 180 },
      "data_field": "rpt v_monthly_kpis[total_orders]",
      "aggregation": "SUM",
      "number_format": "Whole Number (#,##0)"
    },
    {
      "visual_id": "card_aov",
      "visual_type": "card",
      "title": "Average Order Value (AOV)",
      "position": { "x": 760, "y": 20, "width": 350, "height": 180 },
      "dax_measure": "DIVIDE(SUM('rpt v_monthly_kpis'[gross_revenue]), SUM('rpt v_monthly_kpis'[total_orders]), BLANK())",
      "number_format": "Currency (R$ #,##0.00)"
    },
    {
      "visual_id": "card_cancellation",
      "visual_type": "card",
      "title": "Cancellation Rate %",
      "position": { "x": 1130, "y": 20, "width": 350, "height": 180 },
      "dax_measure": "DIVIDE(SUM('rpt v_monthly_kpis'[canceled_orders]), SUM('rpt v_monthly_kpis'[total_orders_all]), BLANK()) * 100",
      "number_format": "Percentage (0.00%)"
    },
    {
      "visual_id": "slicer_period",
      "visual_type": "slicer",
      "title": "Select Reporting Period",
      "position": { "x": 1500, "y": 20, "width": 400, "height": 180 },
      "data_field": "rpt v_monthly_kpis[year_month]",
      "slicer_mode": "Dropdown"
    },
    {
      "visual_id": "chart_monthly_trajectory",
      "visual_type": "lineClusteredColumnComboChart",
      "title": "Monthly Revenue & Order Volume Trajectory",
      "position": { "x": 20, "y": 220, "width": 1150, "height": 840 },
      "x_axis": "rpt v_monthly_kpis[year_month]",
      "column_y_axis": "SUM(rpt v_monthly_kpis[gross_revenue])",
      "line_y_axis": "SUM(rpt v_monthly_kpis[total_orders])"
    },
    {
      "visual_id": "chart_top_categories",
      "visual_type": "clusteredBarChart",
      "title": "Top 10 Product Categories by GMV (BRL)",
      "position": { "x": 1190, "y": 220, "width": 710, "height": 840 },
      "y_axis_category": "rpt v_category_performance[category_en]",
      "x_axis_value": "SUM(rpt v_category_performance[gross_revenue])",
      "top_n_filter": 10
    }
  ]
}

