{
  "name": "Corporate MIS Executive Theme",
  "dataColors": [
    "#1B365D",
    "#2F5597",
    "#4682B4",
    "#5B9BD5",
    "#ED7D31",
    "#70AD47",
    "#264478",
    "#A5A5A5"
  ],
  "background": "#FFFFFF",
  "foreground": "#1B365D",
  "tableAccent": "#1B365D",
  "good": "#2E7D32",
  "neutral": "#F57C00",
  "bad": "#C62828",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI",
      "color": "#1B365D"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B365D"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#FFFFFF"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#595959"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "outspacePane": [
          {
            "backgroundColor": { "solid": { "color": "#F4F6F9" } }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#1B365D" } },
            "fontSize": 24
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#595959" } },
            "fontSize": 10
          }
        ]
      }
    }
  }
}

