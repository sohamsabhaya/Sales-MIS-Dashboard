{
  "page_name": "Regional Performance & Targets",
  "resolution": "1920x1080 (16:9)",
  "source_table": "rpt v_regional_performance",
  "visuals": [
    {
      "visual_id": "card_p2_revenue",
      "visual_type": "card",
      "title": "Actual Regional Revenue (BRL)",
      "position": { "x": 20, "y": 20, "width": 350, "height": 180 },
      "data_field": "rpt v_regional_performance[gross_revenue]",
      "aggregation": "SUM",
      "number_format": "Currency (R$ #,##0.00)"
    },
    {
      "visual_id": "card_p2_target",
      "visual_type": "card",
      "title": "Target Revenue Budget (BRL)",
      "position": { "x": 390, "y": 20, "width": 350, "height": 180 },
      "data_field": "rpt v_regional_performance[target_amount]",
      "aggregation": "SUM",
      "number_format": "Currency (R$ #,##0.00)"
    },
    {
      "visual_id": "card_p2_achievement",
      "visual_type": "card",
      "title": "Target Achievement %",
      "position": { "x": 760, "y": 20, "width": 350, "height": 180 },
      "dax_measure": "DIVIDE(SUM('rpt v_regional_performance'[gross_revenue]), SUM('rpt v_regional_performance'[target_amount]), BLANK()) * 100",
      "number_format": "Percentage (0.00%)"
    },
    {
      "visual_id": "card_p2_gap",
      "visual_type": "card",
      "title": "Target Variance Gap (BRL)",
      "position": { "x": 1130, "y": 20, "width": 350, "height": 180 },
      "dax_measure": "SUM('rpt v_regional_performance'[gross_revenue]) - SUM('rpt v_regional_performance'[target_amount])",
      "number_format": "Currency (R$ #,##0.00)"
    },
    {
      "visual_id": "slicer_p2_period",
      "visual_type": "slicer",
      "title": "Select Reporting Period",
      "position": { "x": 1500, "y": 20, "width": 400, "height": 180 },
      "data_field": "rpt v_regional_performance[year_month]",
      "slicer_mode": "Dropdown"
    },
    {
      "visual_id": "chart_p2_actual_vs_target",
      "visual_type": "clusteredColumnChart",
      "title": "Actual vs Target Revenue by Macro-Region",
      "position": { "x": 20, "y": 220, "width": 1150, "height": 450 },
      "x_axis_category": "rpt v_regional_performance[region_name]",
      "y_axis_values": [
        "SUM(rpt v_regional_performance[gross_revenue])",
        "SUM(rpt v_regional_performance[target_amount])"
      ],
      "sort": "gross_revenue Descending"
    },
    {
      "visual_id": "chart_p2_contribution_donut",
      "visual_type": "donutChart",
      "title": "Regional Revenue Contribution %",
      "position": { "x": 1190, "y": 220, "width": 710, "height": 450 },
      "legend_category": "rpt v_regional_performance[region_name]",
      "values": "SUM(rpt v_regional_performance[gross_revenue])"
    },
    {
      "visual_id": "table_p2_scorecard",
      "visual_type": "table",
      "title": "Regional Performance Scorecard",
      "position": { "x": 20, "y": 690, "width": 1880, "height": 370 },
      "columns": [
        { "name": "Macro Region", "field": "rpt v_regional_performance[region_name]" },
        { "name": "Gross Revenue (BRL)", "field": "SUM(rpt v_regional_performance[gross_revenue])", "format": "R$ #,##0.00" },
        { "name": "Target Revenue (BRL)", "field": "SUM(rpt v_regional_performance[target_amount])", "format": "R$ #,##0.00" },
        { "name": "Achievement %", "field": "AVERAGE(rpt v_regional_performance[target_achievement_pct])", "format": "0.00%" },
        { "name": "Target Variance Gap (BRL)", "field": "SUM(rpt v_regional_performance[target_gap])", "format": "R$ #,##0.00" },
        { "name": "Total Orders", "field": "SUM(rpt v_regional_performance[orders_count])", "format": "#,##0" },
        { "name": "National Contribution %", "field": "AVERAGE(rpt v_regional_performance[regional_contribution_pct])", "format": "0.00%" }
      ],
      "sort": "gross_revenue Descending"
    }
  ]
}

